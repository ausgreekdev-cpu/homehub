{
  "name": "homehub",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @homehub/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db reset --seed",
    "supabase:start": "supabase start",
    "supabase:functions:serve": "supabase functions serve"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "prettier": "3.3.3",
    "eslint": "9.13.0"
  }
}
